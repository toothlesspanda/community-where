<div data-controller="search" style="max-height: fit-content;">
  <div>
    <div class="input-group z-1">
      <span style="color: #adadad" class="input-group-text common-border bg-white p-0" id="search-label">
           <button class="btn btn-mute h-100 d-inline d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMenuFilters" aria-expanded="false" aria-controls="collapseMenuFilters">
            <i class="bi bi-list"></i>
          </button>
         <i class="bi bi-search m-1 mx-2"></i>
      </span>

      <input style="color: #616161" class="form-control position-relative border-start-0 p-1" type="search" placeholder="<%= t('search.placeholder') %>" aria-describedby="search-label" aria-label="Search"
             data-search-target="input"
             data-action="input->search#search"
        />
    </div>
    <div style="max-height: 300px;" data-search-target="suggestions" class="position-absolute card d-none z-2 mt-2 overflow-auto p-2 z-3"></div>
    <div style="">
      <div class="collapse d-md-none" id="collapseMenuFilters">
          <%= render "home/filters" %>
      </div>
    </div>
  </div>
</div>