<div data-controller="search" class="mb-3">
  <button type="button" class="btn btn-sm btn-mute text-muted d-sm-none search-toggle p-0"
          data-action="click->search#toggle">
    <i class="bi bi-search"></i>
  </button>
  <div class="input-group d-none d-sm-flex" data-search-target="wrapper">
    <span class="input-group-text bg-white border-end-0" style="color: #adadad">
      <i class="bi bi-search"></i>
    </span>
    <input class="form-control border-start-0 ps-0" type="search"
           placeholder="<%= t('search.placeholder') %>"
           aria-label="Search"
           data-search-target="input"
           data-action="input->search#search" />
  </div>
  <div style="max-height: 300px;" data-search-target="suggestions"
       class="card d-none mt-1 overflow-auto p-2 position-relative"></div>
</div>
