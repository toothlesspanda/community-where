<div class="card mt-3 rounded-4" style="max-height: 80vh;">
  <div class="card-body overflow-auto">
    <span class="fs-3"> Filter </span>

    <%= form_with url: "", method: :get, id: "map-filter", data: { map_target: "form", action: "change->map#filtersChanged" } do %>

      <div class="accordion" id="categoriesAccordion" class="border-0">
        <% @parent_categories.each do |parent| %>

          <div class="accordion-item">
            <h2 class="accordion-header" id="heading-<%= parent.id %>">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= parent.id %>" aria-expanded="false" aria-controls="collapse-<%= parent.id %>">
                <div class="map-dot" style="background: <%= parent.hex_color %>"></div>
                <%= parent.code.humanize %>
              </button>
            </h2>

            <div id="collapse-<%= parent.id %>" class="accordion-collapse collapse">
              <div class="accordion-body">

                <% parent.children.each do |child| %>
                  <div class="form-check">
                    <%= check_box_tag "category_ids[]",
                                      child.id,
                                      params[:category_ids]&.include?(child.id.to_s),
                                      class: "form-check-input",
                                      id: "cat_#{child.id}" %>

                    <%= label_tag "cat_#{child.id}", child.code.humanize, class: "form-check-label" %>
                  </div>
                <% end %>

              </div>
            </div>
          </div>

        <% end %>
      </div>

    <% end %>
  </div>
</div>