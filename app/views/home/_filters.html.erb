<%= form_with url: "", method: :get, id: "map-filter" do %>
  <% @parent_categories.each do |parent| %>
    <% children = parent.children.select { |c| @category_ids_with_markers.include?(c.id) } %>
    <% next if children.empty? %>

    <div class="mb-3">
      <div class="d-flex align-items-center gap-2 mb-2">
        <i class="map-marker-icon <%= parent.icon || 'fa-solid fa-location-dot' %>" style="--marker-color:<%= parent.hex_color %>;"></i>
        <span class="fw-semibold"><%= parent.human_name %></span>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <% children.each do |child| %>
          <div>
            <input type="checkbox" class="btn-check" name="category_ids[]"
                   value="<%= child.id %>" id="cat_<%= child.id %>"
                   <%= 'checked' if params[:category_ids]&.include?(child.id.to_s) %>>
            <label class="btn btn-sm btn-outline-secondary rounded-pill" for="cat_<%= child.id %>">
              <%= child.human_name %>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
