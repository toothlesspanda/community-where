    <div class="position-absolute top-0 start-0 p-3 z-2" style="width: 75vw">
      <%= render "home/search" %>
    </div>

    <div class="position-absolute top-0 end-0 p-3 z-2 d-none d-md-block">
      <%= render "home/filters" %>
    </div>
  </div>

</div>