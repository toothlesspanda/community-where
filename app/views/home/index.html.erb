<div>
  <div data-controller="search" class="d-flex w-100 justify-content-center position-absolute top-0 mt-3 z-3">

    <div class="w-50 me-2">
      <div>
        <i class="bi bi-crosshair text-info"></i> <span class="text-muted">Your current location: </span>
      </div>

      <div class="input-group input-group-lg">
        <span style="color: #adadad" class="input-group-text bg-white pe-0" id="search-label"><i class="bi bi-search"></i></span>

        <input style="color: #616161" class="form-control position-relative border-start-0" type="search" placeholder="Pesquisar localização..." aria-describedby="search-label" aria-label="Search"
               data-search-target="input"
               data-action="input->search#search"
          />
      </div>

      <div style="max-height: 300px;" data-search-target="suggestions" class="card d-none z-2 mt-2 overflow-auto p-2"></div>
    </div>

  </div>
  <div data-controller="map" data-map-url-value="<%= markers_url %>" class="position-relative vh-100">

    <div data-map-target="map" class="w-100 h-100 z-0"></div>

    <div class="position-absolute top-0 end-0 z-1 h-100">
      <div class="card m-3 rounded-4" style="width: 250px; max-height: calc(100% - 2rem);">
        <div class="card-body overflow-auto">
          <h2> Filter </h2>

          <%= form_with url: "", method: :get,
                        data: {
                          map_target: "form",
                          action: "change->map#filtersChanged"
                        },
                        id: "map-filter" do %>

            <div class="accordion" id="categoriesAccordion" class="border-0">
              <% @parent_categories.each_with_index do |parent, index| %>

                <div class="accordion-item">
                  <h2 class="accordion-header" id="heading-<%= parent.id %>">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#collapse-<%= parent.id %>"
                      aria-expanded="false"
                      aria-controls="collapse-<%= parent.id %>"
                    >
                      <div style="
                      background: <%= parent.hex_color %>;
                        width:16px;
                        height:16px;
                        border-radius:50%;
                        border:2px solid white;
                        margin-right: 16px;
                        box-shadow:0 0 4px rgba(0,0,0,0.3);
                      "></div>
                      <%= parent.code.humanize %>
                    </button>
                  </h2>

                  <div
                    id="collapse-<%= parent.id %>"
                    class="accordion-collapse collapse"
                  >
                    <div class="accordion-body">

                      <% parent.children.each do |child| %>
                        <div class="form-check">
                          <%= check_box_tag "category_ids[]",
                                            child.id,
                                            params[:category_ids]&.include?(child.id.to_s),
                                            class: "form-check-input",
                                            id: "cat_#{child.id}" %>

                          <%= label_tag "cat_#{child.id}",
                                        child.code.humanize,
                                        class: "form-check-label" %>
                        </div>
                      <% end %>

                    </div>
                  </div>
                </div>

              <% end %>
            </div>

          <% end %>
        </div>
      </div>


    </div>

  </div>
</div>