<%= button_to toggle_theme_path,
                method: :post,
                form: { data: { turbo_stream: true } },
                class: "btn btn-sm btn-outline-secondary",
                id: "theme-toggle" do %>
    <% if session[:theme] == "halloween" %>
        <i class="bi bi-beaker-fill text-primary"></i>
    <% else %>
      <i class="bi bi-tree-fill text-primary"></i>
    <% end %>
<% end %>