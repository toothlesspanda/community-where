<!DOCTYPE html>
<html>
  <head>
    <title>Studio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body class="bg-light">
    <% if session[:studio_authenticated] %>
      <nav class="navbar navbar-light bg-white border-bottom mb-4">
        <div class="container">
          <a class="navbar-brand fw-semibold" href="<%= studio_root_path %>">Studio</a>
          <div class="d-flex align-items-center gap-3">
            <a href="<%= studio_submissions_path %>" class="text-decoration-none text-muted">Submissions</a>
            <a href="<%= studio_suggestions_path %>" class="text-decoration-none text-muted">Suggestions</a>
            <a href="<%= studio_proposals_path %>" class="text-decoration-none text-muted">Proposals</a>
            <a href="/jobs" class="text-decoration-none text-muted">Jobs</a>
            <%= button_to "Logout", studio_logout_path, method: :delete,
                class: "btn btn-sm btn-outline-secondary" %>
          </div>
        </div>
      </nav>
    <% end %>

    <div class="container">
      <% if flash[:alert] %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
