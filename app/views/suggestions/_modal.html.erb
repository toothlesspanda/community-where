<div class="modal fade" id="suggestionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-semibold"><%= t('suggestions.title') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small"><%= t('suggestions.description') %></p>
        <%= turbo_frame_tag "suggestion-modal" do %>
          <%= render "suggestions/form", suggestion: Suggestion.new %>
        <% end %>
      </div>
    </div>
  </div>
</div>
