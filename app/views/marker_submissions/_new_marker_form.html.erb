<%= form_with model: MarkerSubmission.new,  data: {
  controller: "new-marker",
  action: "turbo:submit-end->new-marker#submitEnd"
} do |f| %>
  <%= render "shared/form_errors", object: @marker_submission %>

  <p class="text-muted small mb-3"><%= t('markers.form_hint') %></p>

  <div class="row mb-2">
    <div class="col">
      <%= f.label :latitude, t('marker_submissions.form.latitude'), class: "text-muted small" %>
      <%= f.text_field :latitude, id: "latField", class: "form-control form-control-sm",
          data: { action: "change->map#coordsChanged" } %>
    </div>
    <div class="col">
      <%= f.label :longitude, t('marker_submissions.form.longitude'), class: "text-muted small" %>
      <%= f.text_field :longitude, id: "lngField", class: "form-control form-control-sm",
          data: { action: "change->map#coordsChanged" } %>
    </div>
    <div class="col-auto d-flex align-items-end">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-action="click->map#useMyLocation"
              title="<%= t('markers.current_location') %>">
        <i class="bi bi-crosshair"></i>
      </button>
    </div>
  </div>

  <div class="form-group mb-3">
    <%= f.label :address, t('marker_submissions.form.address'), class: "text-muted small" %>
    <%= f.text_field :address, id: "addressField", class: "form-control form-control-sm" %>
  </div>

  <ul class="nav nav-tabs nav-fill mb-3" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-pt" type="button" role="tab">
        PT <span class="text-danger">*</span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-en" type="button" role="tab">
        EN <span class="text-muted fw-normal" style="font-size: 0.75rem;"><%= t('marker_submissions.form.optional') %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="tab-pt" role="tabpanel">
      <div class="form-group mb-3">
        <%= f.label :name, t('marker_submissions.form.name'), class: "text-muted" %>
        <%= f.text_field :name, class: "form-control", required: true, placeholder: t('marker_submissions.form.name_placeholder') %>
      </div>
      <div class="form-group mb-3 d-none">
        <%= f.label :description, t('marker_submissions.form.description'), class: "text-muted" %>
        <%= f.text_area :description, class: "form-control", rows: 3, placeholder: t('marker_submissions.form.description_placeholder') %>
      </div>
    </div>

    <div class="tab-pane fade" id="tab-en" role="tabpanel">
      <div class="form-group mb-3">
        <%= f.label :name_en, t('marker_submissions.form.name'), class: "text-muted" %>
        <%= f.text_field :name_en, class: "form-control", placeholder: t('marker_submissions.form.name_placeholder_en') %>
      </div>
      <div class="form-group mb-3 d-none">
        <%= f.label :description_en, t('marker_submissions.form.description'), class: "text-muted" %>
        <%= f.text_area :description_en, class: "form-control", rows: 3, placeholder: t('marker_submissions.form.description_placeholder_en') %>
      </div>
    </div>
  </div>

  <div class="form-group mb-3">
    <label class="text-muted"><%= t('marker_submissions.form.category') %></label>
    <% @all_parent_categories.each do |parent| %>
      <% next if parent.children.empty? %>
      <div class="mb-2">
        <small class="text-muted fw-semibold"><%= parent.human_name %></small>
        <div class="d-flex flex-wrap gap-2 mt-1">
          <% parent.children.each do |child| %>
            <div class="form-check form-check-inline">
              <%= check_box_tag "marker_submission[category_ids][]", child.id, false,
                    id: "category_#{child.id}", class: "form-check-input" %>
              <%= label_tag "category_#{child.id}", child.human_name, class: "form-check-label small" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%= recaptcha_tags %>

  <%= f.submit t('marker_submissions.form.submit'), class: "btn btn-primary w-100" %>
<% end %>
